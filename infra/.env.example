# =============================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Academia de Baile
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env a control de versiones.
# =============================================================

# ========================
# BASE DE DATOS (PostgreSQL)
# ========================
POSTGRES_DB=academia_baile
POSTGRES_USER=academy_user
# Usa una contraseña segura generada, por ejemplo:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_PORT=5432

# ========================
# BACKEND (Spring Boot)
# ========================
BACKEND_PORT=8080

# JWT Secret — debe tener al menos 43 caracteres (256 bits en base64).
# Genera uno seguro con:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Cuenta de administrador inicial.
# Estas credenciales se usan SOLO en el primer arranque si no existe
# un usuario administrador en la base de datos.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ========================
# FRONTEND (Nginx)
# ========================
# Puerto expuesto en el host. En desarrollo: 4200. En producción: 80
FRONTEND_PORT=4200
