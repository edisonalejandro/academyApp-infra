# Variables de entorno para el entorno local de Academia de Baile
# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL
DB_USER=academyapp
DB_PASSWORD=change_me_local
DB_NAME=academyapp_db

# JWT
JWT_SECRET=change_me_jwt_secret_local

# Redis (solo necesario en producción)
REDIS_PASSWORD=

# Docker registry (solo necesario para producción)
REGISTRY=ghcr.io/edisonalejandro
IMAGE_TAG=latest
